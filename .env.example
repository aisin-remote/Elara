APP_NAME=Orbitra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orbitra
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Read-only corporate organization directory (PostgreSQL).
ORG_DB_HOST=127.0.0.1
ORG_DB_PORT=5432
ORG_DB_DATABASE=postgres
ORG_DB_SCHEMA=public
ORG_DB_USERNAME=postgres
ORG_DB_PASSWORD=
ORG_DB_SSLMODE=prefer
ORG_DB_REQUIRED=true
ORG_JIT_AUTH=false
ORG_WORKSPACE_PUBLIC_ID=
ORG_IT_DEPARTMENT_CODE=ITD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@orbitra.test"
MAIL_FROM_NAME="${APP_NAME}"

ORBITRA_EMAIL_VERIFICATION=false
ORBITRA_MAX_FILE_UPLOAD_KB=10240
ORBITRA_BOTTLENECK_DAYS=7
ORBITRA_MESSAGE_EDIT_WINDOW_MINUTES=15

ORBITRA_LINKEDIN_URL=
ORBITRA_X_URL=
ORBITRA_GITHUB_URL=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI="${APP_URL}/api/internal/integrations/slack/callback"
SLACK_SCOPES=chat:write,channels:read
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/internal/integrations/google_drive/callback"
GOOGLE_SCOPES=openid,profile,email,https://www.googleapis.com/auth/drive.file
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/api/internal/integrations/github/callback"
GITHUB_SCOPES=read:user,public_repo
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI="${APP_URL}/api/internal/integrations/zoom/callback"
ZOOM_SCOPES=user:read:user,meeting:write:meeting

# AI task breakdown (PRD-06). Without a key, approval still succeeds and the breakdown
# is recorded as failed with the reason visible; manual task entry is unaffected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60
ORBITRA_AI_HISTORY_MESSAGES=20
ORBITRA_AI_MAX_OUTPUT_TOKENS=1500
ORBITRA_AI_MAX_TOOL_ROUNDS=3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
